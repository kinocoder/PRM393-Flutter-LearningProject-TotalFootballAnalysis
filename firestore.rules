rules_version = '2';

// Mỗi người dùng chỉ đọc/ghi dữ liệu của chính UID mình.
// Phần lineups (C01/C04) do mảng C viết; mảng D bổ sung rule cho users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/lineups/{lineupId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.id == lineupId
        && request.resource.data.formationId in ['4-3-3', '4-4-2']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.slots is map;
    }
  }
}
